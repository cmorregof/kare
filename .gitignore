*.pdf

# Banco de preguntas real: no se publica hasta el artículo, para no
# contaminar modelos futuros. Solo la plantilla va al repositorio.
eval/*.csv
!eval/pallqa_es_template.csv

# Audio: nunca al repositorio
*.ogg
*.oga
*.opus
*.mp3
*.m4a
*.wav
*.webm

