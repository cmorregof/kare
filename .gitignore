# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.uv/

# Secretos
.env
.env.local

# Datos locales: índice SQLite y corridas de evaluación (con calificaciones)
data/
runs/

# Corpus: los documentos no se versionan (licencias); el manifiesto sí
