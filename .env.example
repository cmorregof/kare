# Copia este archivo como .env y llena solo lo que uses.
# Nunca subas .env al repositorio.

# --- Modelo de lenguaje ------------------------------------------------------
# anthropic | openai_compat | none (solo recuperación: muestra pasajes, no genera)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Verificador: vacío = el mismo modelo del generador
VERIFIER_MODEL=

# OpenAI o compatibles (OpenRouter, Groq). Para Ollama local, la pregunta no
# sale del equipo:
#   LLM_PROVIDER=openai_compat
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=<modelo instalado en Ollama>
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Algunos modelos de OpenAI piden max_completion_tokens
OPENAI_MAX_TOKENS_FIELD=max_tokens

LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=90

# --- Transcripción de preguntas dictadas (nunca audio con pacientes) ---------
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
TRANSCRIPTION_LANGUAGE=es
KEYTERMS_PATH=config/keyterms_paliativos.txt
# Respaldo: Whisper de OpenAI (usa OPENAI_API_KEY)
WHISPER_MODEL=whisper-1

# --- Corpus ------------------------------------------------------------------
MANIFEST_PATH=corpus/manifest.yaml
CORPUS_DIR=corpus/fuentes
DB_PATH=data/kare.db

# --- Recuperación y abstención -----------------------------------------------
TOP_K=8
MIN_COVERAGE=0.3
KEEP_PARTIAL_CLAIMS=false

LOG_LEVEL=INFO
